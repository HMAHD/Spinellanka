TRANSACTIONAL_MAILER_PROVIDER=fake
POSTMARK_API_KEY=
POSTMARK_SERVER_TOKEN=

PAYMENT_GATEWAY=fake
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
